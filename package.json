{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/storeLogic.test.ts",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');const d=p.join('node_modules','.bin');if(fs.existsSync(d)){fs.readdirSync(d).filter(f=>f.endsWith('.cmd')).forEach(f=>{const fp=p.join(d,f);fs.writeFileSync(fp,fs.readFileSync(fp,'utf8').replace(/SET dp0=%~dp0/g,'SET \\\"dp0=%~dp0\\\"'))})}\""
  },
